[Unit]
Description=Read-only integrity audit of 01Academy CRM offsite backups

[Service]
Type=oneshot
User=crmbackup
Group=crmbackup
Environment=HOME=/var/lib/crmbackup
EnvironmentFile=/etc/default/01academy-offsite-backup
ExecStart=/opt/01academy-backup/bin/audit-offsite-backup-vault
UMask=0077
TimeoutStartSec=1h
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateDevices=true
PrivateMounts=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadOnlyPaths=/opt/01academy-backup /srv/backups/01academy-crm/hourly
ReadWritePaths=/var/lib/crmbackup/state
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
