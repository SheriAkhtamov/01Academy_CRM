{
  "name": "academy-crm",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts server/learning-api.ts server/learning-worker.ts server/learning-health.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && npm run build:meta-tools && npm run check:production-bundle",
    "build:meta-tools": "esbuild scripts/configure-telegram-marketing.ts scripts/import-meta-lead-ads.ts scripts/repair-meta-lead-channels.ts scripts/repair-meta-lead-fields.ts scripts/sync-meta-marketing.ts scripts/reconnect-instagram.ts scripts/lms-import-legacy.ts scripts/lms-health.ts scripts/lms-api-acceptance.ts scripts/import-operational-workbook.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/scripts",
    "import:meta-leads": "node dist/scripts/import-meta-lead-ads.js",
    "import:lms-legacy": "node dist/scripts/lms-import-legacy.js",
    "import:operational-workbook": "node dist/scripts/import-operational-workbook.js",
    "start:prod": "node apply-migrations.js && node dist/index.js",
    "start:lms-api": "tsx server/learning-api.ts",
    "start:lms-api:prod": "node dist/learning-api.js",
    "start:lms-worker": "tsx server/learning-worker.ts",
    "start:lms-worker:prod": "node dist/learning-worker.js",
    "health:lms-worker": "node dist/learning-health.js",
    "check": "tsc && npm run lint && npm run check:architecture && npm run check:encoding && npm run check:i18n && npm run check:responsive",
    "lint": "eslint client/src server shared tests --max-warnings 30",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:production-bundle": "node scripts/check-production-bundle.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "audit:security": "node scripts/audit-dependencies.mjs && npm audit signatures && npm run check:secrets",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:dev": "tsx scripts/init-dev-data.ts",
    "db:migrate": "node apply-migrations.js",
    "health:lms": "node dist/scripts/lms-health.js",
    "lms:acceptance": "tsx scripts/lms-api-acceptance.ts"
  },
