{
  "name": "academy-crm",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && npm run check:production-bundle",
    "start:prod": "node apply-migrations.js && node dist/index.js",
    "check": "tsc && npm run lint && npm run check:architecture && npm run check:encoding && npm run check:i18n && npm run check:a11y",
    "lint": "eslint client/src server shared tests --max-warnings 30",
    "check:telegram-bot": "npm --prefix telegram-bot run typecheck",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:production-bundle": "node scripts/check-production-bundle.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "audit:telegram-bot": "npm --prefix telegram-bot audit --audit-level=moderate && npm --prefix telegram-bot audit signatures",
    "audit:security": "npm audit --audit-level=moderate && npm audit signatures && npm run audit:telegram-bot && npm run check:secrets",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:dev": "tsx scripts/init-dev-data.ts",
    "db:migrate": "node apply-migrations.js",
    "db:backup": "node scripts/backup-database.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
