    "@types/bcrypt": "^5.0.2",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@xswitch/rtc": "^1.13.3",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "lucide-react": "^0.453.0",
